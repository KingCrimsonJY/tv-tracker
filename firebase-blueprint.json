{
  "entities": {
    "Title": {
      "title": "Title",
      "description": "A movie, TV series, or custom media item tracked by the user.",
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["tmdb", "url", "custom"], "maxLength": 16 },
        "sourceId": { "type": "string", "maxLength": 128 },
        "mediaType": { "type": "string", "enum": ["movie", "tv", "other"], "maxLength": 16 },
        "names": { "type": "object" },
        "displayLang": { "type": "string", "enum": ["zh", "original", "en", "custom"], "maxLength": 16 },
        "year": { "type": "number" },
        "runtimeMin": { "type": "number" },
        "genres": { "type": "array" },
        "posterPath": { "type": "string", "maxLength": 512 },
        "backdropPath": { "type": "string", "maxLength": 512 },
        "overview": { "type": "object" },
        "showStatus": { "type": "string", "maxLength": 64 },
        "externalIds": { "type": "object" },
        "ratings": { "type": "object" },
        "manualState": { "type": "string", "enum": ["paused", "dropped"], "maxLength": 16 },
        "playthroughs": { "type": "array" },
        "activePlaythroughId": { "type": "string", "maxLength": 128 },
        "resume": { "type": "object" },
        "metaFetchedAt": { "type": "number" },
        "addedAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastActivityAt": { "type": "number" }
      },
      "required": ["source", "mediaType", "names", "playthroughs", "activePlaythroughId", "addedAt", "updatedAt", "lastActivityAt"]
    },
    "Season": {
      "title": "Season",
      "description": "Season episode metadata for a TV series or multi-episode item.",
      "type": "object",
      "properties": {
        "seasonNumber": { "type": "number" },
        "name": { "type": "string", "maxLength": 256 },
        "episodes": { "type": "array" }
      },
      "required": ["seasonNumber", "name", "episodes"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Episode and movie watch timestamps for a specific playthrough.",
      "type": "object",
      "properties": {
        "watched": { "type": "object" },
        "movieWatchedAt": { "type": "number" }
      },
      "required": ["watched"]
    },
    "WatchList": {
      "title": "WatchList",
      "description": "Ordered watch list or unordered collection.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "type": "string", "enum": ["ordered", "collection"], "maxLength": 16 },
        "description": { "type": "string", "maxLength": 1000 },
        "pinned": { "type": "boolean" },
        "rank": { "type": "string", "maxLength": 128 },
        "collectionSort": { "type": "string", "enum": ["added", "name", "year", "rating", "manual"], "maxLength": 16 },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "kind", "pinned", "rank", "collectionSort", "createdAt"]
    },
    "ListEntry": {
      "title": "ListEntry",
      "description": "An item entry inside a watch list.",
      "type": "object",
      "properties": {
        "titleId": { "type": "string", "maxLength": 128 },
        "rank": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 500 },
        "addedAt": { "type": "number" }
      },
      "required": ["titleId", "rank", "addedAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "User preferences and home section layout.",
      "type": "object",
      "properties": {
        "defaultTitleLang": { "type": "string", "enum": ["zh", "original", "en"], "maxLength": 16 },
        "includeSpecials": { "type": "boolean" },
        "homeSections": { "type": "array" },
        "theme": { "type": "string", "enum": ["dark", "light", "system"], "maxLength": 16 }
      },
      "required": ["defaultTitleLang", "includeSpecials", "homeSections", "theme"]
    }
  },
  "firestore": {
    "/users/{userId}/titles/{titleId}": {
      "schema": { "$ref": "#/entities/Title" },
      "description": "User's tracked movies and TV shows."
    },
    "/users/{userId}/titles/{titleId}/seasons/{seasonNumber}": {
      "schema": { "$ref": "#/entities/Season" },
      "description": "Cached season and episode metadata for a title."
    },
    "/users/{userId}/titles/{titleId}/progress/{playthroughId}": {
      "schema": { "$ref": "#/entities/Progress" },
      "description": "Watch progress map per playthrough."
    },
    "/users/{userId}/lists/{listId}": {
      "schema": { "$ref": "#/entities/WatchList" },
      "description": "User's custom ordered lists and collections."
    },
    "/users/{userId}/lists/{listId}/entries/{entryId}": {
      "schema": { "$ref": "#/entities/ListEntry" },
      "description": "Entries linking titles into a list with fractional rank."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "User application settings (settings/app)."
    }
  }
}
