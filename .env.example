# DATA_DIR: Directory where tracker.db, backups, and exports are stored (default: ./data)
DATA_DIR="./data"

# APP_PASSWORD_HASH: Optional scrypt password hash override (generate via `npm run set-password`)
APP_PASSWORD_HASH=""

# TRUST_PROXY: Set to 1 when behind a reverse proxy or Cloudflare Tunnel
TRUST_PROXY="0"

# TMDB_READ_TOKEN: TMDB v4 Read Access Token (Bearer auth) or v3 API key
TMDB_READ_TOKEN=""

# OMDB_API_KEY: OMDb API key for ratings
OMDB_API_KEY=""
