# TMDB API Read Access Token (v4 Bearer token or v3 API key)
TMDB_READ_TOKEN=

# OMDb API Key (for IMDb / Rotten Tomatoes / Metacritic ratings)
OMDB_API_KEY=

# Directory for SQLite database, daily backups, and daily JSON exports (default: ./data)
DATA_DIR=./data

# Optional: Path to yt-dlp executable for link import (default: ./.bin/yt-dlp or yt-dlp on PATH; /opt/yt-dlp/yt-dlp in Docker)
YTDLP_PATH=

# Optional: One-time setup code required on first run to set the initial password.
# If omitted, a random setup code is generated at startup and printed to the server log.
SETUP_CODE=

# Optional: Override password hash (generated via `npm run set-password`)
APP_PASSWORD_HASH=

# Optional: Set to 1 when running behind Cloudflare Tunnel or reverse proxy
TRUST_PROXY=0
