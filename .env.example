# TMDB API Read Access Token (v4 Bearer token or v3 API key)
TMDB_READ_TOKEN=

# OMDb API Key (for IMDb / Rotten Tomatoes / Metacritic ratings)
OMDB_API_KEY=

# Directory for SQLite database, daily backups, and daily JSON exports (default: ./data)
DATA_DIR=./data

# Optional: One-time setup code required on first run to set the initial password.
# If omitted, a random setup code is generated at startup and printed to the server log.
SETUP_CODE=

# Optional: Override password hash (generated via `npm run set-password`)
APP_PASSWORD_HASH=

# Optional: Set to 1 only behind Cloudflare Tunnel or a reverse proxy that overwrites forwarding headers.
# Keep 0 when the port is exposed directly; clients could otherwise spoof them.
TRUST_PROXY=0

# Optional: Path to a private Netscape-format cookie file for yt-dlp.
# Use only your own account, keep it outside Git, and never expose it in the UI.
# yt-dlp may update the file; playback restrictions can still apply.
YTDLP_COOKIES_FILE=
